# ============================================================
# .env.local — 本地敏感配置（不入 git）
# 复制本文件为 .env.local 并填入真实值后即可生效。
# 加载顺序：.env → .env.local（后者覆盖前者同名变量）
# ============================================================

# ─────────────────────────── Alipay 沙箱（Phase 2） ───────────────────────────
# 详细申请步骤见 docs/alipay-sandbox-setup.md

# 沙箱 AppId（一定是数字 ID，沙箱环境从 https://open.alipay.com/develop/sandbox/account 获取）
ALIPAY_APP_ID=2021000000000000

# 商户应用私钥（PEM 格式，PKCS1，去掉 BEGIN/END 包裹后的纯 base64）
# 沙箱用 alipay 提供的密钥工具生成，把"应用公钥"上传到沙箱后台
ALIPAY_MERCHANT_PRIVATE_KEY=

# 支付宝公钥（沙箱平台分配，每次上传"应用公钥"后会刷新）
ALIPAY_PUBLIC_KEY=

# 网关 URL（沙箱默认）
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 异步通知回调 URL（可选；留空则仅靠主动 query）
# 本机开发：通常需配合 ngrok / cpolar 等内网穿透才能让 alipay 回调到本机
# 例：https://your-tunnel.ngrok.io/api/payments/alipay/notify
ALIPAY_NOTIFY_URL=

# 同步跳转 URL（必选，alipay 支付完成后用户浏览器跳转）
# 本机开发示例（绑回 backend 直接 redirect 到 H5 订单详情页）
ALIPAY_RETURN_URL=http://localhost:7001/api/payments/alipay/return

# H5 应用首页（alipayReturn 跳转到订单详情时拼接用）
H5_BASE_URL=http://localhost:8000
