{
  "name": "super-tools-admin",
  "version": "1.0.0",
  "description": "Super Tools 后台管理端 - UmiJS + Ant Design Pro + TypeScript",
  "private": true,
  "scripts": {
    "dev": "cross-env BUILD_ENV=development umi dev",
    "build:test": "cross-env BUILD_ENV=test umi build",
    "build:prod": "cross-env BUILD_ENV=production umi build",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^5.3.0",
    "@ant-design/pro-components": "^2.6.0",
    "@ant-design/pro-layout": "^7.17.0",
    "@umijs/plugins": "^4.1.0",
    "antd": "^5.15.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "qs": "^6.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "umi": "^4.3.0",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.0",
    "@types/qs": "^6.9.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@@/(.*)$": "<rootDir>/src/.umi/$1",
      "\\.(css|less)$": "identity-obj-proxy"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.umi/"
    ],
    "transform": {
      "^.+\\.tsx$": [
        "babel-jest",
        {
          "configFile": "./babel.config.jest.js"
        }
      ],
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false,
          "astTransformers": {
            "before": []
          }
        }
      ]
    },
    "testEnvironment": "jsdom",
    "globals": {
      "API_BASE_URL": "http://localhost:7001"
    }
  }
}
