{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "node",
    "importHelpers": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "sourceMap": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/utils/*": ["../../shared/utils/*"],
      "@/appsdk/*": ["../../shared/appsdk/*"],
      "@/hooks/*": ["../../shared/hooks/*"],
      "@/constants/*": ["../../shared/constants/*"],
      "@/contexts/*": ["../../shared/contexts/*"],
      "@/components/*": ["../../shared/components/*"]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": [
    "app.tsx",
    "Loading.tsx",
    "config.ts",
    "service.ts",
    "components",
    "layouts",
    "pages",
    "store",
    "utils",
    "styles",
    "services",
    "mock",
    ".umirc.ts",
    ".umirc.dev.ts",
    ".umirc.preview.ts",
    ".umirc.prod.ts"
  ],
  "exclude": ["node_modules", "dist", ".umi", "src", "services"]
}
